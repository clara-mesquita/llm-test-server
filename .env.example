# Copy to .env and edit. `docker compose up` reads .env automatically.
# (vllm-benchmark.py instead reads these as shell env vars: VLLM_IMAGE,
#  VLLM_PORT, VLLM_EXTRA_ARGS, HF_TOKEN.)

# vLLM image. Pin a known-good tag for reproducibility, e.g. vllm/vllm-openai:v0.28.0
VLLM_IMAGE=vllm/vllm-openai:latest

# Hugging Face model to serve. Default is the public smoke-test model (fits a 4GB GPU).
# Benchmark models (Llama/Gemma) are gated and need HF_TOKEN set below.
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Host port. Avoid 8000 (used by other apps on this machine).
VLLM_PORT=8080

# Required for gated models. Accept the model license on Hugging Face first.
HF_TOKEN=
